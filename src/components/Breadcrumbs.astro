---
// Fil d'Ariane des pages profondes (prestations, zones, articles).
//
// Le composant porte à la fois l'affichage et le balisage BreadcrumbList.
// Chaque page le construisait auparavant de son côté et le passait à
// BaseLayout : huit copies du même bloc, et trois pages qui affichaient le fil
// sans le baliser du tout. Ici, afficher le fil suffit à le déclarer.
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

// Google demande des URL absolues dans le balisage. Le dernier maillon est la
// page courante : il porte un nom, pas de lien, conformément à la spécification.
const breadcrumbList = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href && index < items.length - 1
      ? { item: new URL(item.href, Astro.site).href }
      : {}),
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbList)} />

<nav class="breadcrumbs" aria-label="Fil d’Ariane">
  <div class="container">
    <ol>
      {items.map((item, index) => (
        <li>
          {item.href && index < items.length - 1 ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>
  /* Etait une bande noire, heritee du theme sombre. Dans un site clair elle
     formait un bandeau orphelin entre l'en-tete et le contenu, et son texte
     gris y tombait a 2,82:1. Elle fait desormais partie du corps de page. */
  .breadcrumbs {
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
    padding-block: 0.6rem;
    font-size: 0.82rem;
  }

  .breadcrumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }

  .breadcrumbs li:not(:last-child)::after {
    content: '›';
    margin-left: 0.4rem;
    color: var(--color-text-muted);
  }

  .breadcrumbs a {
    color: var(--color-text-muted);
  }

  .breadcrumbs a:hover,
  .breadcrumbs a:focus-visible {
    color: var(--color-gold-text);
  }

  .breadcrumbs span[aria-current='page'] {
    color: var(--color-text-muted);
  }
</style>
