---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

const navLinks = [
  { href: '/', label: 'Accueil' },
  { href: '/services/', label: 'Services' },
  { href: '/tarifs/', label: 'Tarifs' },
  { href: '/zones-intervention/', label: 'Zones' },
  { href: '/blog/', label: 'Conseils' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/a-propos/', label: 'À propos' },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="availability-bar">
    <div class="container availability-inner">
      <span class="availability-dot" aria-hidden="true"></span>
      <span>Disponible maintenant — Meaux et villes voisines, 24h/24 · 7j/7</span>
    </div>
  </div>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Serrurier — Accueil">
      <Logo />
    </a>

    <nav class="nav-desktop" aria-label="Navigation principale">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {/* Le nom accessible évite de répéter le numéro : Google le remplace pour
        les visiteurs venus d'une annonce, et un aria-label figé ferait annoncer
        à un lecteur d'écran un numéro différent de celui qui est affiché. */}
    <div class="header-contact">
      <a class="btn btn-primary phone-cta" href={site.phoneHref} aria-label="Appeler le serrurier">
        <Icon name="phone" size={18} />
        <span>{site.phoneDisplay}</span>
      </a>
      {/* Pas de numéro dans ce lien, ni affiché ni lu : Google remplace à
          l'écran le numéro des visiteurs venus d'une annonce par un numéro de
          transfert, qui n'existe pas sur WhatsApp. */}
      <a
        class="whatsapp-cta"
        href={site.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Écrire ou appeler sur WhatsApp"
        title="WhatsApp"
      >
        <Icon name="whatsapp" size={22} />
      </a>
    </div>

    <details class="nav-toggle">
      <summary aria-label="Ouvrir le menu de navigation">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </summary>
      <nav class="nav-mobile" aria-label="Navigation principale (mobile)">
        <ul>
          {navLinks.map((link) => (
            <li>
              <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  /* Bandeau sombre : le logo a un fond noir incruste et ne peut pas etre
     pose sur clair. La couleur de texte doit etre reaffirmee ici, sinon les
     liens heritent du --color-text du corps, presque noir sur noir. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--band-surface);
    color: var(--band-text);
    border-bottom: 1px solid var(--band-border);
  }

  .availability-bar {
    background: var(--color-black);
  }

  .availability-inner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.4rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-white);
  }

  .availability-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3ddc84;
    box-shadow: 0 0 0 3px rgba(61, 220, 132, 0.25);
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .availability-inner span:last-child {
      font-size: 0.75rem;
    }
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-block: 0.75rem;
  }

  .brand {
    margin-right: auto;
  }

  .nav-desktop ul {
    display: flex;
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Jusqu'au 10 novembre 2026, la navigation reprenait un écart plus large
     au-delà de 1200px. Le bouton WhatsApp occupe désormais cette place : avec
     l'écart large, l'en-tête dépassait son conteneur d'une cinquantaine de
     pixels. Ne pas le rétablir sans mesurer. */

  .nav-desktop a {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--band-text);
    text-decoration: none;
    /* Huit entrées depuis l'ajout de Tarifs et Conseils : sans cela « À propos »
       se coupe en deux lignes sur les largeurs intermédiaires. */
    white-space: nowrap;
  }

  .nav-desktop a:hover,
  .nav-desktop a:focus-visible,
  .nav-desktop a[aria-current='page'] {
    color: var(--color-gold-text);
  }

  .phone-cta span {
    white-space: nowrap;
  }

  /* Le bouton WhatsApp prend la hauteur du bouton d'appel par étirement ; sa
     largeur est fixée à cette même hauteur (56px) pour qu'il reste carré.
     aspect-ratio ne suffit pas : un élément étiré par flex ne reporte pas sa
     hauteur sur sa largeur. */
  .header-contact {
    display: flex;
    align-items: stretch;
    gap: var(--space-xs);
  }

  /* Contour et non aplat : l'appel reste l'action principale, et l'or reste
     la seule couleur d'accent de la page. Le glyphe est en --band-text
     (17,74:1), le contour en --band-border-ui (3,77:1). */
  .whatsapp-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    min-height: 44px;
    color: var(--band-text);
    border: 2px solid var(--band-border-ui);
    border-radius: var(--radius);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .whatsapp-cta:hover,
  .whatsapp-cta:focus-visible {
    color: var(--color-gold-text);
    border-color: var(--color-gold-dark);
  }

  /* Le bouton ne paraît dans l'en-tête qu'à partir de 1200px, seule largeur où
     il tient à coup sûr. Mesuré le 10 novembre 2026 : entre 1101 et 1199px la
     navigation complète ne laisse que quelques pixels, et entre 561 et 631px
     il faisait déborder l'en-tête de 71px, défilement horizontal compris.
     Sous 1100px la barre d'appel fixe le porte déjà, à côté du numéro ; le pied
     de page et la page Contact le portent partout. Une seule règle, plutôt
     qu'une plage par largeur où il se trouve tenir. */
  @media (max-width: 1199px) {
    .whatsapp-cta {
      display: none;
    }
  }

  .nav-toggle {
    display: none;
    position: relative;
  }

  .nav-toggle summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
  }

  .nav-toggle summary::-webkit-details-marker {
    display: none;
  }

  .nav-toggle .bar {
    width: 24px;
    height: 2px;
    background: var(--color-gold);
  }

  .nav-mobile {
    position: absolute;
    top: calc(100% + 1px);
    right: 0;
    width: max-content;
    min-width: 220px;
    background: var(--band-surface);
    border: 1px solid var(--band-border-ui);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: var(--space-sm);
  }

  .nav-mobile ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .nav-mobile a {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--band-text);
  }

  @media (max-width: 1100px) {
    .nav-desktop {
      display: none;
    }

    .nav-toggle {
      display: block;
    }

    .header-inner {
      gap: var(--space-sm);
    }
  }

  /* Juste au-dessus de 1100px, logo, navigation complète et numéro demandent
     1042px alors que le conteneur n'en offre que 1038 : le bouton d'appel
     mordait de 4px sur la marge. Mesuré le 11 novembre 2026 sur les 61 pages.
     L'écart resserré rend 16px, ce qui suffit jusqu'à 1200px.
     La borne est 1100.01 et non 1101 : une fenêtre zoomée ou un écran à
     125 % donne des largeurs à virgule, et à 1100,5px ni cette règle ni celle
     du dessus ne s'appliquait — mesuré, le débordement revenait. */
  @media (min-width: 1100.01px) and (max-width: 1199px) {
    .header-inner {
      gap: var(--space-sm);
    }
  }

  /* Juste avant que le numéro ne se replie en icône, logo, numéro et menu
     demandent 504px. Une fenêtre d'ordinateur étroite, dont la barre de
     défilement retire 15px, n'en offre que 498 entre 561 et 567px : le menu
     mordait de 6px sur la marge. Borne à virgule pour la même raison que
     plus haut. */
  @media (min-width: 560.01px) and (max-width: 600px) {
    .header-inner {
      gap: var(--space-xs);
    }
  }

  /* Sous 560px le numéro ne tient plus à côté du logo et du menu : le bouton
     devient un bouton d'appel circulaire. On garde 44px de côté (cible tactile
     minimale recommandée) au lieu de conserver les marges d'un bouton large,
     ce qui donnait un bloc doré presque vide autour d'une petite icône. */
  @media (max-width: 560px) {
    .phone-cta span {
      display: none;
    }

    .phone-cta {
      width: 44px;
      height: 44px;
      min-width: 44px;
      padding: 0;
      gap: 0;
      justify-content: center;
      border-radius: 50%;
    }

    /* Baseline du logo masquée dans le header seulement : elle prend une largeur
       dont le bouton d'appel et le menu ont besoin. Le footer la conserve. */
    .brand :global(.logo-subtitle) {
      display: none;
    }
  }

  /* À 320px, logo, bouton d'appel et menu demandent 291px pour 272 : le menu
     mordait de 19px sur la marge. On resserre l'écart et la marge latérale de
     l'en-tête plutôt que de rapetisser le logo ou la cible tactile du menu. */
  @media (max-width: 340px) {
    .header-inner {
      gap: var(--space-xs);
      padding-inline: 0.75rem;
    }
  }
</style>
