---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<section class="cta-banner">
  <div class="container cta-inner">
    <div>
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-primary" href={site.phoneHref}>
        <Icon name="phone" size={18} />
        <span>Appeler le {site.phoneDisplay}</span>
      </a>
      <a class="btn btn-secondary" href="/contact/">Demander un devis</a>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    background: var(--band-surface);
    color: var(--color-text);
    padding-block: var(--space-lg);
    border-block: 1px solid var(--band-border);
  }

  .cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .cta-banner h2 {
    color: var(--color-gold-text);
    margin-bottom: 0.25rem;
  }

  .cta-banner p {
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .cta-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
</style>
