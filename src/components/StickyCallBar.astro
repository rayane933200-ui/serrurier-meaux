---
// Barre d'appel fixe en bas d'écran sur mobile : le téléphone reste atteignable
// quel que soit le point de la page. Masquée sur grand écran, où le bouton
// d'appel du header est déjà visible en permanence (header sticky).
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<div class="sticky-call">
  <a class="sticky-call-primary" href={site.phoneHref}>
    <Icon name="phone" size={18} />
    <span>{site.phoneDisplay}</span>
  </a>
  <a
    class="sticky-call-whatsapp"
    href={site.whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Écrire ou appeler sur WhatsApp"
    title="WhatsApp"
  >
    <Icon name="whatsapp" size={22} />
  </a>
  <a class="sticky-call-secondary" href="/contact/">Devis gratuit</a>
</div>

<style>
  .sticky-call {
    display: none;
  }

  @media (max-width: 1100px) {
    .sticky-call {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 200;
      display: flex;
      gap: 0.5rem;
      padding: 0.6rem 0.75rem;
      padding-bottom: max(0.6rem, env(safe-area-inset-bottom));
      background: var(--band-surface);
      border-top: 1px solid var(--band-border-ui);
    }

    .sticky-call a {
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 0.95rem;
      /* 0.6rem et non 0.9rem de marge latérale depuis l'ajout de WhatsApp :
         trois boutons doivent tenir sur 360px sans que le libellé se replie. */
      padding: 0.75rem 0.6rem;
      border-radius: var(--radius);
      border: 2px solid transparent;
      text-decoration: none;
      white-space: nowrap;
    }

    .sticky-call-primary {
      background: var(--color-gold);
      color: var(--color-black);
    }

    .sticky-call-secondary {
      color: var(--color-text);
      border-color: var(--band-border-ui);
    }

    /* Filet de sécurité pour les écrans de 320px : le numéro ne se coupe
       jamais, c'est « Devis gratuit » qui passe sur deux lignes. */
    .sticky-call .sticky-call-secondary {
      /* Le contour est redit ici : posé sur .sticky-call-secondary seul, il
         perdait contre le « border: 2px solid transparent » de .sticky-call a,
         plus spécifique, et le bouton paraissait sans bord. */
      border-color: var(--band-border-ui);
      min-width: 0;
      white-space: normal;
      text-align: center;
      line-height: 1.15;
    }

    /* Carré, à sa largeur propre : il ne doit pas prendre au numéro la place
       qu'il lui faut pour tenir sur une ligne à 320px. */
    .sticky-call .sticky-call-whatsapp {
      flex: 0 0 auto;
      min-width: 48px;
      padding-inline: 0;
      color: var(--band-text);
      border-color: var(--band-border-ui);
    }
  }

  @media (max-width: 380px) {
    .sticky-call a {
      font-size: 0.88rem;
    }
  }
</style>
