---
import Icon from './Icon.astro';

interface Props {
  icon: 'key' | 'lock' | 'wrench' | 'shield' | 'van';
  title: string;
  description: string;
  price?: string;
  /** Rend toute la carte cliquable vers la page de la prestation */
  href?: string;
}

const { icon, title, description, price, href } = Astro.props;
---

<article class:list={['service-card', href && 'service-card-link']}>
  <div class="service-icon">
    <Icon name={icon} size={32} />
  </div>
  <h3>
    {href ? <a href={href}>{title}</a> : title}
  </h3>
  <p>{description}</p>
  {price && <p class="service-price">{price}</p>}
  {href && (
    <span class="service-more" aria-hidden="true">En savoir plus →</span>
  )}
</article>

<style>
  .service-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-md);
    box-shadow: var(--shadow-card);
    height: 100%;
  }

  .service-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-bg-alt);
    color: var(--color-gold-dark);
    margin-bottom: var(--space-sm);
  }

  .service-card h3 {
    margin-bottom: 0.5rem;
  }

  .service-card p {
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .service-price {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-gold-text);
    margin-bottom: 0;
  }

  /* Carte cliquable : le lien du titre couvre toute la carte */
  .service-card-link {
    position: relative;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .service-card-link:hover,
  .service-card-link:focus-within {
    border-color: var(--color-gold-text);
    transform: translateY(-2px);
  }

  .service-card-link h3 a {
    color: inherit;
    text-decoration: none;
  }

  .service-card-link h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .service-card-link h3 a:hover,
  .service-card-link h3 a:focus-visible {
    text-decoration: none;
  }

  .service-more {
    margin-top: auto;
    padding-top: var(--space-sm);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .service-card-link:hover .service-more {
    color: var(--color-gold-text);
  }
</style>
