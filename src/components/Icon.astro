// Le glyphe WhatsApp est tracé sur une grille de 24 et l'occupe bord à bord ;
// les autres icônes le sont sur 32, avec trois unités de marge. On le ramène
// dans ce même cadre plutôt que de retoucher son tracé.
const transforms: Record<string, string> = {
  whatsapp: 'translate(3 3) scale(1.0833)',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]} fill="currentColor" transform={transforms[name]}></path>
</svg>
