---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';

const { legal } = site;
const crumbs = [{ label: 'Accueil', href: '/' }, { label: 'Mentions légales' }];

// Une ligne dont la valeur est vide est retirée de l'affichage : mieux vaut une
// mention absente qu'une mention inventée (ces informations sont opposables).
type Row = { term: string; value: string; href?: string };

const publisherRows: Row[] = [
  { term: 'Dénomination', value: `${legal.legalName} — ${legal.legalForm}` },
  { term: 'Enseigne', value: legal.tradeName },
  {
    term: 'Adresse du siège',
    value: `${legal.address}, ${legal.postalCode} ${legal.addressCity}`,
  },
  { term: 'SIREN', value: legal.siren },
  { term: 'SIRET (siège)', value: legal.siret },
  { term: 'Code APE', value: legal.ape },
  { term: 'Début d’activité', value: legal.createdOn },
  { term: 'Téléphone', value: site.phoneDisplay, href: site.phoneHref },
  { term: 'Email', value: site.email, href: `mailto:${site.email}` },
  { term: 'Responsable de la publication', value: legal.publisher },
  { term: 'TVA', value: legal.vatNumber },
].filter((row) => row.value.trim() !== '');

const insuranceRows: Row[] = [
  { term: 'Assureur', value: legal.insurer },
  { term: 'Numéro de contrat', value: legal.insurancePolicy },
  { term: 'Couverture géographique', value: legal.insuranceCoverage },
].filter((row) => row.value.trim() !== '');
---

<BaseLayout
  title="Mentions légales"
  description="Mentions légales du site : éditeur, hébergeur, propriété intellectuelle, données personnelles et droit de rétractation."
>
  <Breadcrumbs items={crumbs} />

  <section class="section page-hero">
    <div class="container">
      <h1>Mentions légales</h1>
      <p>
        Informations légales relatives à l'éditeur du site, conformément à la loi n° 2004-575 du
        21 juin 2004 pour la confiance dans l'économie numérique.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container legal-content">
      <h2>Éditeur du site</h2>
      <dl>
        {publisherRows.map((row) => (
          <div>
            <dt>{row.term}</dt>
            <dd>{row.href ? <a href={row.href}>{row.value}</a> : row.value}</dd>
          </div>
        ))}
      </dl>

      {insuranceRows.length > 0 && (
        <>
          <h2>Assurance professionnelle</h2>
          <dl>
            {insuranceRows.map((row) => (
              <div>
                <dt>{row.term}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
        </>
      )}

      <h2>Hébergement</h2>
      <p>
        Ce site est hébergé par <strong>{legal.host.name}</strong>, {legal.host.address} —{' '}
        <a href={legal.host.url} rel="noopener noreferrer" target="_blank">{legal.host.url}</a>.
      </p>

      <h2>Propriété intellectuelle</h2>
      <p>
        L'ensemble des éléments composant ce site — textes, logo, identité visuelle, structure et
        mise en page — est protégé par le droit de la propriété intellectuelle. Toute reproduction
        ou représentation, totale ou partielle, sans autorisation écrite préalable est interdite.
      </p>

      <h2>Données personnelles</h2>
      <p>
        Ce site dépose un seul traceur, celui de la régie Google Ads, qui sert à savoir si une
        visite fait suite à une annonce. Il est soumis à votre accord préalable : un bandeau vous
        laisse l'accepter ou le refuser à la première visite, et le lien « Cookies » du pied de
        page permet de revenir sur ce choix. Le détail figure dans la
        <a href="/politique-de-confidentialite/">politique de confidentialité</a>.
      </p>
      <p>
        Le formulaire de contact ne transmet aucune donnée à ce site : il ouvre
        votre propre logiciel de messagerie avec un message pré-rempli, que vous restez libre
        d'envoyer ou non. Les informations que vous nous transmettez par email ou par téléphone
        sont utilisées uniquement pour traiter votre demande d'intervention ou de devis, et ne
        sont ni cédées ni revendues.
      </p>
      <p>
        Conformément au Règlement général sur la protection des données (RGPD) et à la loi
        Informatique et Libertés, vous disposez d'un droit d'accès, de rectification, d'effacement
        et d'opposition sur les données vous concernant. Pour l'exercer, écrivez à
        {' '}<a href={`mailto:${site.email}`}>{site.email}</a>. Vous pouvez également introduire
        une réclamation auprès de la CNIL.
      </p>

      {legal.mediator.trim() !== '' && (
        <>
          <h2>Médiation de la consommation</h2>
          <p>
            Conformément à l'article L. 612-1 du Code de la consommation, tout consommateur a le
            droit de recourir gratuitement à un médiateur de la consommation en vue de la
            résolution amiable d'un litige qui l'oppose à un professionnel. Médiateur compétent :
            {' '}{legal.mediator}.
          </p>
        </>
      )}

      <h2>Droit de rétractation</h2>
      <p>
        Pour les prestations conclues hors établissement, le consommateur dispose en principe d'un
        délai de rétractation de quatorze jours. En cas d'intervention urgente demandée
        expressément par le client et exécutée avant la fin de ce délai, la demande expresse
        d'exécution immédiate est recueillie par écrit, conformément aux articles L. 221-25 et
        suivants du Code de la consommation.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: var(--color-bg-alt);
    padding-block: var(--space-lg);
  }

  .page-hero p {
    max-width: 68ch;
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .legal-content {
    max-width: 80ch;
  }

  .legal-content h2 {
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    margin-top: var(--space-lg);
  }

  .legal-content h2:first-child {
    margin-top: 0;
  }

  .legal-content p {
    color: var(--color-text-muted);
  }

  .legal-content dl {
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .legal-content dl div {
    display: grid;
    grid-template-columns: 15rem 1fr;
    gap: var(--space-sm);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border-soft);
  }

  .legal-content dt {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .legal-content dd {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .legal-content dl div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
