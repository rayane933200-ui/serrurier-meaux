---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import Faq from '../../components/Faq.astro';
import VerifierUnSerrurier from '../../components/VerifierUnSerrurier.astro';
import { zones, quartiers, communes } from '../../data/zones';
import { services } from '../../data/services';
import { site } from '../../data/site';

export function getStaticPaths() {
  return zones.map((zone) => ({
    params: { slug: zone.slug },
    props: { zone },
  }));
}

const { zone } = Astro.props;
const nearby = zones.filter((item) => item.slug !== zone.slug && item.type === zone.type).slice(0, 8);

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Zones d’intervention', href: '/zones-intervention/' },
  { label: zone.name },
];

// Sous 160 caractères pour éviter la troncature dans les résultats de recherche.
const description = `Serrurier à ${zone.name} (${zone.postalCode}) : intervention en moins de ${site.responseTime}, ${site.hours}. Tarif annoncé avant déplacement.`;

// FAQ localisée, propre à la zone. Elle ne reprend volontairement PAS les
// questions générales de `featuredFaq` : les réinjecter ici ajoutait ~300 mots
// identiques sur 20 pages et dupliquait le balisage FAQPage de /faq/.
const localFaq = [
  {
    question: `Intervenez-vous à ${zone.name} en pleine nuit ?`,
    answer: `Oui. Nous intervenons à ${zone.name} ${site.hours}, nuit, week-end et jours fériés compris. Comme partout dans le métier, les interventions de nuit, le week-end et les jours fériés sont facturées à un tarif supérieur au tarif de journée, qui vous est annoncé au téléphone avant le déplacement.`,
  },
  {
    question: `Quel est le délai d’intervention à ${zone.name} ?`,
    answer: `Nous visons moins de ${site.responseTime} à ${zone.name}. Le délai réel dépend de votre adresse exacte, de l'heure et de la circulation : il vous est confirmé au téléphone. Indiquer votre rue, l'étage et le code d'accès permet de gagner de précieuses minutes à l'arrivée.`,
  },
];

// Secteur desservi, déclaré explicitement.
//
// Les vingt pages de zone ne portaient jusqu'ici que la fiche d'entreprise, la
// même sur tout le site : rien ne disait à un moteur que CETTE page traite de
// la serrurerie à Beauval plutôt qu'ailleurs. Le code postal lève l'ambiguïté
// mieux qu'un nom de commune, dont plusieurs existent en double en France.
//
// Pour un quartier, la localité reste Meaux : écrire « Beauval » en
// addressLocality serait faux, c'est un quartier, pas une commune.
const secteur = {
  '@type': 'Place',
  name: zone.name,
  address: {
    '@type': 'PostalAddress',
    addressLocality: zone.type === 'quartier' ? 'Meaux' : zone.name,
    postalCode: zone.postalCode,
    addressRegion: 'Île-de-France',
    addressCountry: 'FR',
  },
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Serrurier à ${zone.name}`,
    serviceType: 'Dépannage et serrurerie',
    description,
    provider: { '@id': new URL('/#business', Astro.site).href },
    areaServed: secteur,
    availableChannel: {
      '@type': 'ServiceChannel',
      servicePhone: site.phoneE164,
      serviceUrl: new URL(`/zones/${zone.slug}/`, Astro.site).href,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: localFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<BaseLayout title={zone.metaTitle} description={description} jsonLd={jsonLd} suffix={false}>
  <Breadcrumbs items={crumbs} />

  <section class="section page-hero">
    <div class="container">
      <h1>{zone.h1}</h1>
      <p>{zone.intro}</p>
      <div class="page-hero-actions">
        <a class="btn btn-primary" href={site.phoneHref}>
          <Icon name="phone" size={18} />
          <span>Appeler le {site.phoneDisplay}</span>
        </a>
        <a class="btn btn-outline" href="#devis">Demander un devis</a>
      </div>
      <ul class="hero-badges">
        <li><Icon name="clock" size={18} /> Moins de {site.responseTime}</li>
        <li><Icon name="van" size={18} /> {site.hours}</li>
        <li><Icon name="shield" size={18} /> Tarif annoncé avant déplacement</li>
      </ul>
    </div>
  </section>

  {zone.image && (
    <section class="zone-illustration">
      <div class="container">
        <figure>
          {/* eager + fetchpriority : l'image est juste sous le titre, elle fait
              partie du plus grand élément affiché au chargement. */}
          <Image
            src={zone.image.src}
            alt={zone.image.alt}
            widths={[640, 960, 1280]}
            sizes="(max-width: 1200px) 100vw, 1160px"
            {/* Ces vues urbaines sont riches en détail : sans consigne, Astro les
                sort autour de 400 Ko. 68 tient la qualité perçue pour un quart du poids. */}
            quality={68}
            loading="eager"
            fetchpriority="high"
          />
          {/* Seulement le crédit : répéter l'alt ferait entendre deux fois la
              même phrase à un lecteur d'écran. */}
          <figcaption>{zone.image.credit}</figcaption>
        </figure>
      </div>
    </section>
  )}

  {zone.areas && zone.areas.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>Secteurs desservis à {zone.name}</h2>
        <ul class="areas-list">
          {zone.areas.map((area) => (
            <li>
              <Icon name="map-pin" size={18} />
              <span>{area}</span>
            </li>
          ))}
        </ul>
        <p class="areas-note">
          Nous intervenons dans l'ensemble du secteur {zone.postalCode}, y compris au-delà des
          secteurs cités ici. Un doute sur votre adresse ? Appelez-nous, nous vous le confirmons
          immédiatement.
        </p>
      </div>
    </section>
  )}

  <section class="section section-alt">
    <div class="container">
      <h2>Nos prestations de serrurerie à {zone.name}</h2>
      <div class="services-grid">
        {services.map((service) => (
          <ServiceCard
            icon={service.icon}
            title={service.title}
            description={service.teaser}
            price={service.price}
            href={`/services/${service.slug}/`}
          />
        ))}
      </div>
    </div>
  </section>

  {zone.work && (
    <section class="section">
      <div class="container work-block">
        <h2>Une porte, une serrure, un chantier</h2>
        <figure>
          <Image
            src={zone.work.src}
            alt={zone.work.alt}
            widths={[480, 720, 1000]}
            sizes="(max-width: 900px) 100vw, 620px"
            quality={72}
            loading="lazy"
          />
          {/* La légende dit ce que montre la photo et qui l'a prise. Elle ne
              nomme aucun lieu : ces clichés viennent des interventions de
              l'entreprise, mais la commune de chacun n'est pas établie. */}
          <figcaption>{zone.work.alt}. Photo prise lors d'une de nos interventions.</figcaption>
        </figure>
        <div class="work-text">
          <p>
            Les photos de ce site sont les nôtres. Pas de serrurier souriant acheté en banque
            d'images : des portes, des serrures et des cylindres que nous avons réellement
            ouverts, remplacés ou renforcés.
          </p>
          <p>
            C'est aussi ce que nous vous remettons après chaque intervention : un devis signé
            avant de commencer, une facture qui sépare le déplacement, la main-d'œuvre et les
            fournitures, et l'ancienne pièce déposée. De quoi faire jouer votre
            {' '}<a href="/assurance-habitation/">assurance habitation</a> sans discussion.
          </p>
        </div>
      </div>
    </section>
  )}

  <VerifierUnSerrurier />

  <Faq items={localFaq} title={`Questions fréquentes à ${zone.name}`} />

  <section class="section" id="devis">
    <div class="container quote-layout">
      <div>
        <h2>Un serrurier à {zone.name}</h2>
        <p class="quote-intro">
          Décrivez votre situation, nous vous répondons avec un tarif clair. Pour une urgence,
          l'appel reste le moyen le plus rapide de nous joindre.
        </p>
        <QuoteForm context={zone.name} class="quote-form-inline" />
      </div>

      <div class="nearby">
        <h2>{zone.type === 'quartier' ? 'Autres quartiers de Meaux' : 'Communes voisines'}</h2>
        <ul class="nearby-links">
          {nearby.map((item) => (
            <li><a href={`/zones/${item.slug}/`}>{item.name}</a></li>
          ))}
        </ul>
        <h2 class="nearby-title">
          {zone.type === 'quartier' ? 'Communes du Pays de Meaux' : 'Quartiers de Meaux'}
        </h2>
        <ul class="nearby-links">
          {(zone.type === 'quartier' ? communes : quartiers).slice(0, 9).map((item) => (
            <li><a href={`/zones/${item.slug}/`}>{item.name}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .work-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
  }

  .work-block h2 {
    grid-column: 1 / -1;
    margin-bottom: 0;
  }

  .work-block figure {
    margin: 0;
  }

  .work-block img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  .work-block figcaption {
    margin-top: 0.4rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .work-text p {
    color: var(--color-text-muted);
  }

  @media (max-width: 820px) {
    .work-block {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }

  .zone-illustration {
    padding-top: var(--space-lg);
  }

  .zone-illustration figure {
    margin: 0;
  }

  .zone-illustration img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  .zone-illustration figcaption {
    margin-top: 0.4rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    text-align: right;
  }

  .page-hero {
    background: var(--color-bg-alt);
    padding-block: var(--space-lg);
  }

  .page-hero p {
    max-width: 68ch;
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .page-hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-sm);
  }

  .hero-badges {
    list-style: none;
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    padding: 0;
    margin: var(--space-md) 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .hero-badges li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .hero-badges :global(svg) {
    color: var(--color-gold-dark);
  }

  .areas-list {
    list-style: none;
    margin: var(--space-md) 0 var(--space-sm);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-sm);
  }

  .areas-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
  }

  .areas-list :global(svg) {
    color: var(--color-gold-dark);
    flex-shrink: 0;
  }

  .areas-note {
    color: var(--color-text-muted);
    max-width: 70ch;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .quote-layout {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-lg);
    align-items: start;
  }

  .quote-intro {
    color: var(--color-text-muted);
    max-width: 55ch;
  }

  .nearby h2 {
    font-size: 1.05rem;
  }

  .nearby-title {
    margin-top: var(--space-md);
  }

  .nearby-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    font-size: 0.92rem;
  }

  @media (max-width: 900px) {
    .quote-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
